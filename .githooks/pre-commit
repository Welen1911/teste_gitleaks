#!/bin/sh
# Bloqueia o commit se houver segredos nos arquivos em stage.
# Ativar uma vez por clone: git config core.hooksPath .githooks

if ! command -v docker >/dev/null 2>&1; then
    echo "gitleaks: docker não encontrado, pulando verificação." >&2
    exit 0
fi

docker run --rm -v "$(git rev-parse --show-toplevel)":/repo \
    ghcr.io/gitleaks/gitleaks:v8.30.1 \
    git /repo --pre-commit --staged --redact --no-banner -v

status=$?
if [ $status -ne 0 ]; then
    echo "" >&2
    echo "gitleaks: segredo encontrado, commit bloqueado." >&2
    echo "Remova o segredo (use .env) e tente de novo." >&2
fi
exit $status
